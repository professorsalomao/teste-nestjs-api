
{
  "family": "apinestjs-task",
  "taskRoleArn": "arn:aws:iam::401537511784:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::401537511784:role/ecsTaskExecutionRole",
  "networkMode": "bridge",
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "1024",
  "memory": "3072",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "401537511784.dkr.ecr.us-east-1.amazonaws.com/my-project/apinestjs@sha256:a2dfd561703b691cabb104cd851b8a953e4fb4ba27145dbb2d15a35afd469bec",
      "cpu": 0,
      "essential": true,
      "stopTimeout": 30,
      "portMappings": [
        {
          "containerPort": 3005,
          "hostPort": 80,
          "protocol": "tcp",
          "name": "main-3005-tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "3005"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "DB_HOST",
          "value": "ENDPOINT_DO_POSTGRESQL"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_DATABASE",
          "value": "NOME_DO_BANCO"
        }
      ],
      "secrets": [
        {
          "name": "POSTGRES_PASS",
          "valueFrom": "arn:aws:ssm:us-east-1:401537511784:parameter/nestjs-api/production/POSTGRES_PASS"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"require('http').get('http://127.0.0.1:3005/', (res) => { res.resume(); process.exit(res.statusCode === 200 ? 0 : 1); }).on('error', () => process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 120
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/apinestjs-task",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
      "systemControls": []
    }
  ],
  "volumes": [],
  "placementConstraints": [],
  "enableFaultInjection": false
}
